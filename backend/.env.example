# ==============================================================================
# AgentFlow FastAPI Backend Configuration (Environment Example)
# Target Firebase Project: agentflow-7dc3c
# ==============================================================================

# Server settings
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Google Gemini API
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# Firebase Cloud Firestore & Admin Authentication
FIREBASE_PROJECT_ID="agentflow-7dc3c"

# Set either the credentials file path OR the client email + private key
# FIREBASE_CREDENTIALS_PATH="/path/to/serviceAccountKey.json"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@agentflow-7dc3c.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Auth configuration: allow development tokens in local testing
ALLOW_DEV_TOKENS="true"

# Outbound notification settings
ALERT_EMAIL_RECIPIENT="vivek.gaikwad@mitwpu.edu.in"
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASSWORD="your_sendgrid_api_key"
