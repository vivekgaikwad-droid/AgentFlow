# ==============================================================================
# AgentFlow Configuration (Environment Example)
# Target Firebase Project: agentflow-7dc3c
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side Keys (NEVER prefix with VITE_; NEVER expose in client bundles)
# ------------------------------------------------------------------------------
# Google Gemini API key for server-side orchestrator task decomposition
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# Port and environment
PORT=3000
NODE_ENV="development"

# Firebase Cloud Project Identifier
FIREBASE_PROJECT_ID="agentflow-7dc3c"

# Optional path to downloaded service account JSON file for Firebase Admin SDK
# (Required only for direct server-side Cloud Firestore synchronization)
# FIREBASE_CREDENTIALS_PATH="/path/to/serviceAccountKey.json"

# Alternatively, configure via environment variables directly:
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@agentflow-7dc3c.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. Client-Side Public Configuration (VITE_ prefixed only)
# IMPORTANT: Only public web client configuration belongs here.
# Service account private keys or Gemini keys MUST NEVER be placed here.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="your_firebase_web_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="agentflow-7dc3c.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="agentflow-7dc3c"
VITE_FIREBASE_STORAGE_BUCKET="agentflow-7dc3c.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional external API gateway URL (leave empty when using same-origin /api proxy)
VITE_API_BASE_URL=""
